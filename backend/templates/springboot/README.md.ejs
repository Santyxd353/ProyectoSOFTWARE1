  -H "Content-Type: application/json" \
  -d '{
    <% classes[0].sampleData.forEach(function(field, index) { %>
    "<%= field.key %>": <%= field.value %><% if (index < classes[0].sampleData.length - 1) { %>,<% } %>
    <% }); %>
